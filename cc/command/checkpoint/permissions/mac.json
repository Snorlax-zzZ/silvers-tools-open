{
  "_comment": "把下面 allow 数组里的条目合并到 ~/.claude/settings.json 的 permissions.allow",
  "permissions": {
    "allow": [
      "Read(~/.claude/checkpoints/**)",
      "Write(~/.claude/checkpoints/**)",
      "Edit(~/.claude/checkpoints/**)",
      "Bash(mkdir -p ~/.claude/checkpoints/**)",
      "Bash(ls ~/.claude/checkpoints/**)",
      "Bash(ls -la ~/.claude/checkpoints/**)",
      "Bash(find ~/.claude/checkpoints -name *.md)",
      "Bash(find ~/.claude/checkpoints -maxdepth *:*)",
      "Bash(head -n * ~/.claude/checkpoints/**)",
      "Bash(grep * ~/.claude/checkpoints/**)",
      "Bash(wc -l ~/.claude/checkpoints/**)",
      "Bash(wc -c ~/.claude/checkpoints/**)",
      "Bash(date *)",
      "Bash(mv ~/.claude/checkpoints/** ~/.claude/checkpoints/**)",
      "Bash(bash ~/.claude/scripts/list-checkpoints.sh*)",

      "Read(~/.claude/checkpoints-online/**)",
      "Write(~/.claude/checkpoints-online/**)",
      "Edit(~/.claude/checkpoints-online/**)",
      "Bash(mkdir -p ~/.claude/checkpoints-online/**)",
      "Bash(ls ~/.claude/checkpoints-online/**)",
      "Bash(ls -la ~/.claude/checkpoints-online/**)",
      "Bash(find ~/.claude/checkpoints-online -name *.md)",
      "Bash(find ~/.claude/checkpoints-online -maxdepth *:*)",
      "Bash(head -n * ~/.claude/checkpoints-online/**)",
      "Bash(grep * ~/.claude/checkpoints-online/**)",
      "Bash(mv ~/.claude/checkpoints-online/** ~/.claude/checkpoints-online/**)",
      "Bash(git clone <CHECKPOINT_REPO_URL> ~/.claude/checkpoints-online*)",
      "Bash(git -C ~/.claude/checkpoints-online *)"
    ]
  }
}
